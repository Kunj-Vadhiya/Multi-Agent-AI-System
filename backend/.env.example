# ==============================================================================
# Multi-Agent AI Task Automation System - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Strategy
# ------------------------------------------------------------------------------
# Options:
#   'ollama'      - 100% local, offline GPU/CPU inference (Zero API keys needed!)
#   'groq'        - Ultra-fast cloud LPU inference (<1s response latency)
#   'openai'      - Official OpenAI API models
#   'openrouter'  - Multi-model routing gateway
#   'grok'        - xAI Grok API models
#   'round_robin' - Distributes requests across all configured active providers
LLM_PROVIDER=ollama

# ------------------------------------------------------------------------------
# 2. Local LLM (Ollama) Configuration (Offline & Key-Free)
# ------------------------------------------------------------------------------
# Install Ollama from https://ollama.com and run: ollama run qwen3.5:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b

# ------------------------------------------------------------------------------
# 3. Cloud LLM Providers (Optional for cloud fallback / round-robin)
# ------------------------------------------------------------------------------
# Groq API Configuration (https://console.groq.com/keys)
# Supports comma-separated keys for automatic round-robin rotation & rate-limit failover
GROQ_API_KEYS=your_groq_key_1,your_groq_key_2
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-20b

# OpenAI API Configuration (https://platform.openai.com/api-keys)
OPENAI_API_KEYS=sk-proj-key1,sk-proj-key2
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# OpenRouter API Configuration (https://openrouter.ai/keys)
OPENROUTER_API_KEYS=sk-or-v1-key1,sk-or-v1-key2
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Grok (xAI) API Configuration (https://console.x.ai/)
GROK_API_KEYS=xai-key1,xai-key2
GROK_API_KEY=your_grok_key_here
GROK_MODEL=grok-beta

# ------------------------------------------------------------------------------
# 4. Search Providers
# ------------------------------------------------------------------------------
# Provider selection: 'auto' (falls back gracefully), 'duckduckgo', 'tavily', or 'serper'
SEARCH_PROVIDER=auto
TAVILY_API_KEY=your_tavily_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# ------------------------------------------------------------------------------
# 5. Model Context Protocol (MCP) Configuration (17 Standard Tools)
# ------------------------------------------------------------------------------
# Server endpoint for standalone SSE mode
MCP_SERVER_URL=http://127.0.0.1:8001/sse
# Transport mode: 'auto' (direct in-process sub-millisecond execution, or SSE if server running)
MCP_TRANSPORT=auto

# ------------------------------------------------------------------------------
# 6. Live Email Integration (Gmail SMTP Sending & IMAP Reading)
# ------------------------------------------------------------------------------
# Requires Google 2-Step Verification ON -> Generate App Password at:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_USE_TLS=true

# IMAP Configuration (Live inbox inspection & search)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_16_char_app_password
